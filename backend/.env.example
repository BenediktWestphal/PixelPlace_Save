DATABASE_URL=your_postgresql_connection_string
PORT=3001
VITE_FRONTEND_URL=http://localhost:5173

# SERVER CONFIGURATION
# The application is configured to trust the first hop reverse proxy by default
# (app.set('trust proxy', 1) in server.js).
# This is important for correct IP address resolution (req.ip).
# If your proxy setup is different, you might need to adjust this setting directly in server.js
# or modify server.js to make it configurable via an environment variable like TRUST_PROXY.
# EXAMPLE_TRUST_PROXY="1"
